<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tigerit.registrationsystem.LoginController">
   <children>
      <Label layoutX="186.0" layoutY="47.0" text="Login to your account">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Label layoutX="236.0" layoutY="109.0" text="Email:" />
      <Label layoutX="235.0" layoutY="192.0" text="Password:" />
      <Label layoutX="334.0" layoutY="313.0" onMouseClicked="#registerLabelClicked" text="Register here" textFill="#0728c9" underline="true" />
      <Label layoutX="193.0" layoutY="313.0" text="Don't have an account?" />
      <TextField fx:id="emailTextField" layoutX="235.0" layoutY="133.0" />
      <PasswordField fx:id="passwordField" layoutX="235.0" layoutY="218.0" />
      <Button layoutX="286.0" layoutY="267.0" mnemonicParsing="false" onAction="#loginButtonClicked" text="Login" />
   </children>
</AnchorPane>
